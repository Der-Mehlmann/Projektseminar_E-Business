name: "CodeQL"

on:
  push:
    branches:
      - main
  pull_request:
    # The branches against which pull requests are considered for analysis
    branches:
      - main
  schedule:
    - cron: '30 1 * * 0'

jobs:
  analyze:
    name: Analyze
    runs-on: ubuntu-latest

    steps:
    - name: Checkout repository
      uses: actions/checkout@v4

    - name: Initialize CodeQL
      uses: github/codeql-action/init@v3
      with:
        languages: 'javascript'
        # Adjust the query suite location if you use a custom suite.
        # queries: ./path/to/local/query/suite.

    - name: Perform CodeQL Analysis
      uses: github/codeql-action/analyze@v3
